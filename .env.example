# Opcional: URL canônica usada nos metadados sociais.
NEXT_PUBLIC_SITE_URL=

# Obrigatório para o assistente: API Python que orquestra o agente via MCP.
ATLAS_AGENT_URL=http://localhost:8001

# Opcional localmente; recomendado em produção. Use o mesmo valor na API Python.
ATLAS_AGENT_TOKEN=

# Opcional: entre 5000 e 180000 ms. Padrão: 90000.
ATLAS_AGENT_TIMEOUT_MS=90000
