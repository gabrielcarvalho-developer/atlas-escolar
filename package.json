{
  "name": "atlas-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:build": "node scripts/build-atlas-data.mjs",
    "predev": "npm run data:build",
    "dev": "vinext dev --port 3001",
    "prebuild": "npm run data:build",
    "build": "vinext build",
    "build:vercel": "npm run data:build && next build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "dev:next": "next dev",
    "build:next": "next build",
    "lint": "oxlint app components/atlas-provider.tsx components/atlas-shell.tsx components/atlas-charts.tsx components/webmcp-tools.tsx lib",
    "format": "oxfmt",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-select": "^5.10.2",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0"
  },
  "type": "module"
}
