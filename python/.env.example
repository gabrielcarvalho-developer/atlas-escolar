# === LLM Provider ===
# Opções: "openai", "anthropic", "llama"
LLM_PROVIDER=llama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (alternativo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Llama / OpenAI-compatible (alternativo, compatível com Cloudflare Workers AI)
LLAMA_API_URL=https://api.cloudflare.com/client/v4/accounts/SEU_ACCOUNT_ID
LLAMA_API_KEY=
LLAMA_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# === Atlas Data ===
# Caminho para o JSON gerado pelo build do Next.js
ATLAS_DATA_PATH=../lib/generated/atlas-real-data.json

# === MCP ===
# Vazio: o agente inicia python/mcp_server.py por stdio (recomendado localmente).
# Remoto: informe a URL completa do endpoint Streamable HTTP, terminando em /mcp.
MCP_SERVER_URL=
MCP_READ_TIMEOUT_SECONDS=30

# === API do agente ===
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:3001
# Opcional localmente; recomendado em produção. Deve ser igual ao valor do Next.js.
ATLAS_AGENT_TOKEN=

# === LangSmith (opcional, tracing) ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=atlas-escolar-agent
